# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=
SETUP_KEY=

# 網站網址（組邀請連結用，例如 https://healthec.vercel.app）
NEXT_PUBLIC_SITE_URL=

# LINE 邀請裂變
# 官方帳號 Basic ID（含 @，例如 @123abcde）— LINE Developers > Messaging API
NEXT_PUBLIC_LINE_OA_BASIC_ID=
# LINE Channel secret（驗證 webhook 簽章）
LINE_CHANNEL_SECRET=
# LINE Channel access token（後台回覆訊息用）
LINE_CHANNEL_ACCESS_TOKEN=
# 加入官方帳號後要附帶推給朋友的社群連結（選填）
NEXT_PUBLIC_LINE_COMMUNITY_URL=
# 每邀請一人發給邀請人的積分（預設 10）
REFERRAL_POINTS=10
