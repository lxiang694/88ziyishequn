{
  "manifest_version": 3,
  "name": "健康優選・賣貨便助手",
  "version": "0.2.6",
  "minimum_chrome_version": "104",
  "description": "在健康優選發起轉單，傳送官方匯入檔並核對賣貨便結果。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.88ziyishequn.com/*", "https://healthec.vercel.app/*", "https://myship.7-11.com.tw/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "content_scripts": [
    {"matches": ["https://www.88ziyishequn.com/admin/*", "https://healthec.vercel.app/admin/*"], "js": ["compat.js", "health.js"], "run_at": "document_idle"},
    {"matches": ["https://myship.7-11.com.tw/orderimport/*", "https://myship.7-11.com.tw/seller/order/*"], "js": ["myship.js"], "run_at": "document_idle"}
  ]
}
